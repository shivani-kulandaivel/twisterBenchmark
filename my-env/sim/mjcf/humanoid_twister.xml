<mujoco model="twister_humanoid">
  <compiler angle="degree" coordinate="local" inertiafromgeom="false"/>
  <option gravity="0 0 -9.81" timestep="0.01" integrator="RK4"/>

  <default>
    <joint limited="true" damping="4" armature="0.04"/>
    <geom friction="1.2 0.05 0.005" condim="3" margin="0.002" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <position kp="90" kv="12" forcerange="-250 250"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="grid" rgba="0.85 0.85 0.85 1"/>

    <!-- Twister mat (visual only, no collision) -->
    <geom name="twister_mat" type="box" size="1.15 0.8 0.012" pos="0 0 -0.012" rgba="0.96 0.96 0.94 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c0" type="cylinder" size="0.12 0.006" pos="-0.875 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c1" type="cylinder" size="0.12 0.006" pos="-0.525 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c2" type="cylinder" size="0.12 0.006" pos="-0.175 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c3" type="cylinder" size="0.12 0.006" pos="0.175 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c4" type="cylinder" size="0.12 0.006" pos="0.525 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r0_c5" type="cylinder" size="0.12 0.006" pos="0.875 -0.525 0.006" rgba="0.85 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c0" type="cylinder" size="0.12 0.006" pos="-0.875 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c1" type="cylinder" size="0.12 0.006" pos="-0.525 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c2" type="cylinder" size="0.12 0.006" pos="-0.175 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c3" type="cylinder" size="0.12 0.006" pos="0.175 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c4" type="cylinder" size="0.12 0.006" pos="0.525 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r1_c5" type="cylinder" size="0.12 0.006" pos="0.875 -0.175 0.006" rgba="0.95 0.85 0.1 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c0" type="cylinder" size="0.12 0.006" pos="-0.875 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c1" type="cylinder" size="0.12 0.006" pos="-0.525 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c2" type="cylinder" size="0.12 0.006" pos="-0.175 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c3" type="cylinder" size="0.12 0.006" pos="0.175 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c4" type="cylinder" size="0.12 0.006" pos="0.525 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r2_c5" type="cylinder" size="0.12 0.006" pos="0.875 0.175 0.006" rgba="0.2 0.75 0.25 1" contype="0" conaffinity="0"/>
    <geom name="mat_r3_c0" type="cylinder" size="0.12 0.006" pos="-0.875 0.525 0.006" rgba="0.15 0.35 0.85 1" contype="0" conaffinity="0"/>
    <geom name="mat_r3_c1" type="cylinder" size="0.12 0.006" pos="-0.525 0.525 0.006" rgba="0.15 0.35 0.85 1" contype="0" conaffinity="0"/>
    <geom name="mat_r3_c2" type="cylinder" size="0.12 0.006" pos="-0.175 0.525 0.006" rgba="0.15 0.35 0.85 1" contype="0" conaffinity="0"/>
    <geom name="mat_r3_c3" type="cylinder" size="0.12 0.006" pos="0.175 0.525 0.006" rgba="0.15 0.35 0.85 1" contype="0" conaffinity="0"/>
