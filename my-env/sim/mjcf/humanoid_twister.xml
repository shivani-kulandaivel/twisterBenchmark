<mujoco model="twister_humanoid">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.01" integrator="RK4"/>

  <default>
    <joint limited="true" damping="2" armature="0.02"/>
    <geom friction="1.0 0.3 0.3" condim="3" margin="0.001"/>
    <position kp="200" kv="15" forcerange="-300 300"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="grid" rgba="0.85 0.85 0.85 1"/>

    <body name="pelvis" pos="0 0 1.02">
      <geom name="pelvis_geom" type="capsule" size="0.09" fromto="0 0 0 0 0 0.08" rgba="0.2 0.2 0.7 1"/>

      <body name="torso" pos="0 0 0.1">
        <joint name="abdomen_pitch" type="hinge" axis="1 0 0" range="-30 30"/>
        <geom name="torso_geom" type="capsule" size="0.11" fromto="0 0 0 0 0 0.35" rgba="0.25 0.25 0.75 1"/>
        <site name="torso_top" pos="0 0 0.35" size="0.02"/>

        <body name="head" pos="0 0 0.38">
          <geom name="head_geom" type="sphere" size="0.12" rgba="0.9 0.75 0.65 1"/>
        </body>

        <!-- Left arm -->
        <body name="left_upper_arm" pos="0.14 0 0.28">
          <joint name="left_shoulder_pitch" type="hinge" axis="0 1 0" range="-120 120"/>
          <joint name="left_shoulder_roll" type="hinge" axis="1 0 0" range="-90 90"/>
          <geom type="capsule" size="0.045" fromto="0 0 0 0.22 0 0" rgba="0.9 0.75 0.65 1"/>
          <body name="left_forearm" pos="0.22 0 0">
            <joint name="left_elbow" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.04" fromto="0 0 0 0.2 0 0" rgba="0.9 0.75 0.65 1"/>
            <site name="left_hand" pos="0.2 0 0" size="0.03" rgba="1 0 0 1"/>
          </body>
        </body>

        <!-- Right arm -->
        <body name="right_upper_arm" pos="-0.14 0 0.28">
          <joint name="right_shoulder_pitch" type="hinge" axis="0 1 0" range="-120 120"/>
          <joint name="right_shoulder_roll" type="hinge" axis="1 0 0" range="-90 90"/>
          <geom type="capsule" size="0.045" fromto="0 0 0 -0.22 0 0" rgba="0.9 0.75 0.65 1"/>
          <body name="right_forearm" pos="-0.22 0 0">
            <joint name="right_elbow" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.04" fromto="0 0 0 -0.2 0 0" rgba="0.9 0.75 0.65 1"/>
            <site name="right_hand" pos="-0.2 0 0" size="0.03" rgba="0 0 1 1"/>
          </body>
        </body>
      </body>

      <!-- Left leg -->
      <body name="left_thigh" pos="0.1 0 -0.02">
        <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-120 45"/>
        <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-45 45"/>
        <geom type="capsule" size="0.055" fromto="0 0 0 0 0 -0.38" rgba="0.15 0.15 0.6 1"/>
        <body name="left_shin" pos="0 0 -0.38">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="0 150"/>
          <geom type="capsule" size="0.05" fromto="0 0 0 0 0 -0.36" rgba="0.15 0.15 0.6 1"/>
          <body name="left_foot_body" pos="0 0 -0.36">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-45 45"/>
            <geom name="left_foot_geom" type="box" size="0.08 0.04 0.02" pos="0.04 0 -0.02" rgba="0.1 0.1 0.5 1"/>
            <site name="left_foot" pos="0.08 0 -0.02" size="0.03" rgba="1 0.5 0 1"/>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="right_thigh" pos="-0.1 0 -0.02">
        <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-120 45"/>
        <joint name="right_hip_roll" type="hinge" axis="1 0 0" range="-45 45"/>
        <geom type="capsule" size="0.055" fromto="0 0 0 0 0 -0.38" rgba="0.15 0.15 0.6 1"/>
        <body name="right_shin" pos="0 0 -0.38">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="0 150"/>
          <geom type="capsule" size="0.05" fromto="0 0 0 0 0 -0.36" rgba="0.15 0.15 0.6 1"/>
          <body name="right_foot_body" pos="0 0 -0.36">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-45 45"/>
            <geom name="right_foot_geom" type="box" size="0.08 0.04 0.02" pos="0.04 0 -0.02" rgba="0.1 0.1 0.5 1"/>
            <site name="right_foot" pos="0.08 0 -0.02" size="0.03" rgba="0 0.5 1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_abdomen_pitch" joint="abdomen_pitch"/>
    <position name="act_left_shoulder_pitch" joint="left_shoulder_pitch"/>
    <position name="act_left_shoulder_roll" joint="left_shoulder_roll"/>
    <position name="act_left_elbow" joint="left_elbow"/>
    <position name="act_right_shoulder_pitch" joint="right_shoulder_pitch"/>
    <position name="act_right_shoulder_roll" joint="right_shoulder_roll"/>
    <position name="act_right_elbow" joint="right_elbow"/>
    <position name="act_left_hip_pitch" joint="left_hip_pitch"/>
    <position name="act_left_hip_roll" joint="left_hip_roll"/>
    <position name="act_left_knee" joint="left_knee"/>
    <position name="act_left_ankle" joint="left_ankle"/>
    <position name="act_right_hip_pitch" joint="right_hip_pitch"/>
    <position name="act_right_hip_roll" joint="right_hip_roll"/>
    <position name="act_right_knee" joint="right_knee"/>
    <position name="act_right_ankle" joint="right_ankle"/>
  </actuator>
</mujoco>
