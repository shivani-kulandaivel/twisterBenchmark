    <geom name="mat_r3_c5" type="cylinder" size="0.12 0.006" pos="0.875 0.525 0.006" rgba="0.15 0.35 0.85 1" contype="0" conaffinity="0"/>

    <body name="pelvis" pos="0 0 0.92">
      <freejoint name="root"/>
      <inertial mass="14" pos="0 0 -0.03" diaginertia="0.12 0.10 0.08"/>
      <geom name="pelvis_geom" type="capsule" size="0.08" fromto="0 0 -0.02 0 0 0.06" rgba="0.2 0.2 0.7 1"/>

      <body name="torso" pos="0 0 0.08">
        <joint name="abdomen_pitch" type="hinge" axis="1 0 0" range="-25 25" damping="6"/>
        <inertial mass="12" pos="0 0 0.12" diaginertia="0.30 0.26 0.16"/>
        <geom name="torso_geom" type="capsule" size="0.10" fromto="0 0 0 0 0 0.32" rgba="0.25 0.25 0.75 1"/>
        <site name="torso_top" pos="0 0 0.32" size="0.02"/>

        <body name="head" pos="0 0 0.34">
          <inertial mass="4" pos="0 0 0" diaginertia="0.04 0.04 0.03"/>
          <geom name="head_geom" type="sphere" size="0.10" rgba="0.9 0.75 0.65 1"/>
        </body>

        <!-- Left arm -->
        <body name="left_upper_arm" pos="0.12 0 0.26">
          <joint name="left_shoulder_pitch" type="hinge" axis="0 1 0" range="-140 140"/>
          <joint name="left_shoulder_roll" type="hinge" axis="1 0 0" range="-110 30"/>
          <inertial mass="2.0" pos="0.11 0 0" diaginertia="0.02 0.02 0.01"/>
          <geom type="capsule" size="0.04" fromto="0 0 0 0.22 0 0" rgba="0.9 0.75 0.65 1"/>
          <body name="left_forearm" pos="0.22 0 0">
            <joint name="left_elbow" type="hinge" axis="0 1 0" range="-5 145"/>
            <inertial mass="1.2" pos="0.10 0 0" diaginertia="0.01 0.01 0.005"/>
            <geom type="capsule" size="0.035" fromto="0 0 0 0.20 0 0" rgba="0.9 0.75 0.65 1"/>
            <site name="left_hand" pos="0.20 0 0" size="0.03" rgba="1 0 0 1"/>
          </body>
        </body>

        <!-- Right arm -->
        <body name="right_upper_arm" pos="-0.12 0 0.26">
          <joint name="right_shoulder_pitch" type="hinge" axis="0 1 0" range="-140 140"/>
          <joint name="right_shoulder_roll" type="hinge" axis="1 0 0" range="-30 110"/>
          <inertial mass="2.0" pos="-0.11 0 0" diaginertia="0.02 0.02 0.01"/>
          <geom type="capsule" size="0.04" fromto="0 0 0 -0.22 0 0" rgba="0.9 0.75 0.65 1"/>
          <body name="right_forearm" pos="-0.22 0 0">
            <joint name="right_elbow" type="hinge" axis="0 1 0" range="-5 145"/>
            <inertial mass="1.2" pos="-0.10 0 0" diaginertia="0.01 0.01 0.005"/>
            <geom type="capsule" size="0.035" fromto="0 0 0 -0.20 0 0" rgba="0.9 0.75 0.65 1"/>
            <site name="right_hand" pos="-0.20 0 0" size="0.03" rgba="0 0 1 1"/>
          </body>
        </body>
      </body>

      <!-- Left leg -->
      <body name="left_thigh" pos="0.09 0 0">
        <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-110 35"/>
        <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-35 35"/>
        <inertial mass="6.0" pos="0 0 -0.16" diaginertia="0.08 0.08 0.03"/>
        <geom type="capsule" size="0.05" fromto="0 0 0 0 0 -0.34" rgba="0.15 0.15 0.6 1"/>
        <body name="left_shin" pos="0 0 -0.34">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-5 135"/>
          <inertial mass="4.0" pos="0 0 -0.15" diaginertia="0.05 0.05 0.02"/>
          <geom type="capsule" size="0.045" fromto="0 0 0 0 0 -0.32" rgba="0.15 0.15 0.6 1"/>
          <body name="left_foot_body" pos="0 0 -0.32">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-35 35"/>
            <inertial mass="2.5" pos="0.05 0 -0.02" diaginertia="0.008 0.015 0.015"/>
            <geom name="left_foot_geom" type="box" size="0.11 0.07 0.025" pos="0.05 0 -0.025" rgba="0.1 0.1 0.5 1"/>
            <site name="left_foot" pos="0.09 0 -0.025" size="0.03" rgba="1 0.5 0 1"/>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="right_thigh" pos="-0.09 0 0">
        <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-110 35"/>
        <joint name="right_hip_roll" type="hinge" axis="1 0 0" range="-35 35"/>
        <inertial mass="6.0" pos="0 0 -0.16" diaginertia="0.08 0.08 0.03"/>
        <geom type="capsule" size="0.05" fromto="0 0 0 0 0 -0.34" rgba="0.15 0.15 0.6 1"/>
        <body name="right_shin" pos="0 0 -0.34">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-5 135"/>
          <inertial mass="4.0" pos="0 0 -0.15" diaginertia="0.05 0.05 0.02"/>
          <geom type="capsule" size="0.045" fromto="0 0 0 0 0 -0.32" rgba="0.15 0.15 0.6 1"/>
          <body name="right_foot_body" pos="0 0 -0.32">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-35 35"/>
            <inertial mass="2.5" pos="-0.05 0 -0.02" diaginertia="0.008 0.015 0.015"/>
            <geom name="right_foot_geom" type="box" size="0.11 0.07 0.025" pos="-0.05 0 -0.025" rgba="0.1 0.1 0.5 1"/>
            <site name="right_foot" pos="-0.09 0 -0.025" size="0.03" rgba="0 0.5 1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_abdomen_pitch" joint="abdomen_pitch" kp="70" kv="10"/>
    <position name="act_left_shoulder_pitch" joint="left_shoulder_pitch" kp="45" kv="8" forcerange="-100 100"/>
    <position name="act_left_shoulder_roll" joint="left_shoulder_roll" kp="45" kv="8" forcerange="-100 100"/>
    <position name="act_left_elbow" joint="left_elbow" kp="50" kv="8" forcerange="-80 80"/>
    <position name="act_right_shoulder_pitch" joint="right_shoulder_pitch" kp="45" kv="8" forcerange="-100 100"/>
    <position name="act_right_shoulder_roll" joint="right_shoulder_roll" kp="45" kv="8" forcerange="-100 100"/>
    <position name="act_right_elbow" joint="right_elbow" kp="50" kv="8" forcerange="-80 80"/>
    <position name="act_left_hip_pitch" joint="left_hip_pitch" kp="110" kv="14"/>
    <position name="act_left_hip_roll" joint="left_hip_roll" kp="110" kv="14"/>
    <position name="act_left_knee" joint="left_knee" kp="110" kv="14"/>
    <position name="act_left_ankle" joint="left_ankle" kp="90" kv="12"/>
    <position name="act_right_hip_pitch" joint="right_hip_pitch" kp="110" kv="14"/>
    <position name="act_right_hip_roll" joint="right_hip_roll" kp="110" kv="14"/>
    <position name="act_right_knee" joint="right_knee" kp="110" kv="14"/>
    <position name="act_right_ankle" joint="right_ankle" kp="90" kv="12"/>
  </actuator>
</mujoco>
